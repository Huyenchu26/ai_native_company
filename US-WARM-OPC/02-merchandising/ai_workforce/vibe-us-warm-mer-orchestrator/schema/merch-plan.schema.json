{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://us-warm-opc/schema/merch-plan.schema.json",
  "title": "Merchandising Plan (orchestrator output)",
  "description": "Dispatch plan pricing->preview->listing->go-live. Consumes design CLEAR from 01 (enum CLEAR/MODIFY/REJECT/PENDING matches prd-orchestrator). Gate: go_live[] items require all three upstream gates true. evidence[] = unified company contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["batch_id", "priced_skus", "go_live", "gate_checks", "evidence", "confidence_score", "need_review"],
  "properties": {
    "batch_id": { "type": "string", "minLength": 1 },
    "priced_skus": {
      "type": "array",
      "items": {
        "type": "object", "required": ["sku", "design_clearance"],
        "properties": {
          "sku": { "type": "string" },
          "design_clearance": { "type": "string", "enum": ["CLEAR", "MODIFY", "REJECT", "PENDING"] }
        }
      }
    },
    "previews": { "type": "array", "items": { "type": "object" } },
    "listings": { "type": "array", "items": { "type": "object" } },
    "go_live": {
      "type": "array",
      "description": "Only SKUs cleared for go-live. Each item MUST have all three upstream gates true.",
      "items": {
        "type": "object",
        "required": ["sku", "pricing_floor_pass", "images_on_disk", "product_page_publish_ready"],
        "properties": {
          "sku": { "type": "string" },
          "pricing_floor_pass": { "const": true },
          "images_on_disk": { "const": true },
          "product_page_publish_ready": { "const": true }
        }
      }
    },
    "gate_checks": {
      "type": "object",
      "properties": {
        "design_clearance": { "type": "string", "enum": ["CLEAR", "MODIFY", "REJECT", "PENDING"] }
      }
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["claim", "verbatim_quote", "source"],
        "properties": { "claim": {"type": "string"}, "verbatim_quote": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "location": {"type": "string"} } }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "need_review": { "type": "boolean" }
  },
  "allOf": [
    {
      "$comment": "Fail-closed: need_review=false => confidence>=0.7.",
      "if": { "required": ["need_review"], "properties": { "need_review": { "const": false } } },
      "then": { "required": ["confidence_score"], "properties": { "confidence_score": { "minimum": 0.7 } } }
    }
  ]
}
