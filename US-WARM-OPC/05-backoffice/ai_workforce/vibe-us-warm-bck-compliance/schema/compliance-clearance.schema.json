{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://us-warm-opc/schema/compliance-clearance.schema.json",
  "title": "Compliance Clearance (BCK-004 output)",
  "description": "Official US compliance sign-off. bck-compliance is the SOLE authority issuing clearance_id (fixes EU H5). Gates: clearance_id => CPSC+FTC+IP all pass; ip_status=CLEAR => uspto_checked + 0 licensed. evidence[] unified contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["product_id", "cpsc_pass", "cpsc_fiber_label", "ftc_pass", "ip_status", "uspto_checked", "licensed_char_match", "clearance_id", "evidence", "confidence_score", "need_review"],
  "properties": {
    "product_id": { "type": "string", "minLength": 1 },
    "cpsc_pass": { "type": "boolean" },
    "cpsc_fiber_label": { "type": ["string", "null"], "description": "Fiber content % + origin + RN. null -> cpsc_pass must be false." },
    "flammability_class": { "type": ["string", "null"], "enum": ["Class 1", "Class 2", "Class 3", null], "description": "16 CFR 1610. Class 3 is not acceptable for apparel/textile." },
    "ftc_pass": { "type": "boolean", "description": "No fake review, no deceptive, Made-in-USA only if qualified." },
    "ip_status": { "type": "string", "enum": ["CLEAR", "MODIFY", "REJECT", "PENDING"] },
    "uspto_checked": { "type": "boolean" },
    "licensed_char_match": { "type": "integer", "minimum": 0 },
    "clearance_id": { "type": ["string", "null"], "description": "Official ID. Present ONLY when all three (CPSC/FTC/IP) pass. Downstream (01 handoff, 02 publish) require this." },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["claim", "verbatim_quote", "source"],
        "properties": { "claim": {"type": "string"}, "verbatim_quote": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "location": {"type": "string"} } }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "need_review": { "type": "boolean" }
  },
  "allOf": [
    {
      "$comment": "GATE: clearance_id present => CPSC pass AND FTC pass AND IP CLEAR.",
      "if": { "required": ["clearance_id"], "properties": { "clearance_id": { "type": "string", "minLength": 1 } } },
      "then": { "required": ["cpsc_pass", "ftc_pass", "ip_status"],
        "properties": { "cpsc_pass": {"const": true}, "ftc_pass": {"const": true}, "ip_status": {"const": "CLEAR"} } }
    },
    {
      "$comment": "GATE: ip_status=CLEAR => uspto_checked AND 0 licensed matches (US single-market).",
      "if": { "required": ["ip_status"], "properties": { "ip_status": { "const": "CLEAR" } } },
      "then": { "required": ["uspto_checked", "licensed_char_match"],
        "properties": { "uspto_checked": {"const": true}, "licensed_char_match": {"const": 0} } }
    },
    {
      "$comment": "GATE: cpsc_pass=true => fiber label present.",
      "if": { "required": ["cpsc_pass"], "properties": { "cpsc_pass": { "const": true } } },
      "then": { "required": ["cpsc_fiber_label"], "properties": { "cpsc_fiber_label": {"type": "string", "minLength": 1} } }
    },
    {
      "$comment": "Fail-closed.",
      "if": { "required": ["need_review"], "properties": { "need_review": { "const": false } } },
      "then": { "required": ["confidence_score"], "properties": { "confidence_score": { "minimum": 0.7 } } }
    }
  ]
}
