{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://us-warm-opc/schema/workforce-report.schema.json",
  "title": "AI Workforce Report (BCK-006 output)",
  "description": "Ops/HR for the AI worker roster. Gate: worker_count must be counted from folders (count_method=actual), never hard-coded (fix EU hard-code-12). evidence[] unified contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["period", "worker_count", "count_method", "reject_rate", "evidence", "confidence_score", "need_review"],
  "properties": {
    "period": { "type": "string" },
    "worker_count": { "type": "integer", "minimum": 0 },
    "count_method": { "type": "string", "enum": ["actual", "estimate"], "description": "actual = counted from ai_workforce/ folders; hard-coded numbers are forbidden." },
    "uptime_pct": { "type": ["number", "null"] },
    "reject_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["claim", "verbatim_quote", "source"],
        "properties": { "claim": {"type": "string"}, "verbatim_quote": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "location": {"type": "string"} } }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "need_review": { "type": "boolean" }
  },
  "allOf": [
    { "$comment": "Gate: reject_rate reported => count_method=actual (report grounded in real roster).",
      "if": { "required": ["need_review"], "properties": { "need_review": { "const": false } } },
      "then": { "required": ["confidence_score", "count_method"],
        "properties": { "confidence_score": { "minimum": 0.7 }, "count_method": { "const": "actual" } } } }
  ]
}
