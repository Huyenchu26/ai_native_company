{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://us-warm-opc/schema/backoffice-plan.schema.json",
  "title": "Backoffice Plan (orchestrator output)",
  "description": "Routes tax/books/profit/compliance/privacy/workforce for DAKOfits US. evidence[] unified contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["batch_id", "tasks", "compliance_clearances", "evidence", "confidence_score", "need_review"],
  "properties": {
    "batch_id": { "type": "string", "minLength": 1 },
    "tasks": { "type": "array", "items": { "type": "object" } },
    "compliance_clearances": {
      "type": "array",
      "description": "Issued clearances. Each with a clearance_id must be all-pass.",
      "items": { "type": "object", "required": ["product_id", "clearance_issued"],
        "properties": { "product_id": {"type": "string"}, "clearance_issued": {"type": "boolean"} } }
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["claim", "verbatim_quote", "source"],
        "properties": { "claim": {"type": "string"}, "verbatim_quote": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "location": {"type": "string"} } }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "need_review": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "required": ["need_review"], "properties": { "need_review": { "const": false } } },
      "then": { "required": ["confidence_score"], "properties": { "confidence_score": { "minimum": 0.7 } } } }
  ]
}
