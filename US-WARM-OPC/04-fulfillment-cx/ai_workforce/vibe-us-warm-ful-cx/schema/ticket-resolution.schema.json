{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://us-warm-opc/schema/ticket-resolution.schema.json",
  "title": "CX Ticket / Return Resolution (FUL-003/004 output)",
  "description": "US CX + returns. Gates: refund>$30 => human (not auto); personalized final-sale for changed-mind only (defect always refundable); real reply (no empty auto). evidence[] unified contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["ticket_id", "category", "reason", "personalized", "refund_amount", "refund_auto_approved", "final_sale_applies", "first_response_hours", "auto_resolved", "evidence", "confidence_score", "need_review"],
  "properties": {
    "ticket_id": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "enum": ["order-status", "return", "personalization", "complaint"] },
    "reason": { "type": "string", "enum": ["defect", "not-as-described", "changed-mind", "inquiry"] },
    "personalized": { "type": "boolean" },
    "refund_amount": { "type": "number", "minimum": 0 },
    "refund_auto_approved": { "type": "boolean" },
    "final_sale_applies": { "type": "boolean" },
    "first_response_hours": { "type": "number", "minimum": 0 },
    "auto_resolved": { "type": "boolean" },
    "reply_text": { "type": "string" },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["claim", "verbatim_quote", "source"],
        "properties": { "claim": {"type": "string"}, "verbatim_quote": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "location": {"type": "string"} } }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "need_review": { "type": "boolean" }
  },
  "allOf": [
    {
      "$comment": "GATE refund>30 => not auto (human).",
      "if": { "required": ["refund_auto_approved"], "properties": { "refund_auto_approved": { "const": true } } },
      "then": { "required": ["refund_amount", "reason"],
        "properties": { "refund_amount": { "maximum": 30 }, "reason": { "enum": ["defect", "not-as-described"] } } }
    },
    {
      "$comment": "GATE final-sale only for changed-mind on personalized (defect never final-sale).",
      "if": { "required": ["final_sale_applies"], "properties": { "final_sale_applies": { "const": true } } },
      "then": { "required": ["reason", "personalized"],
        "properties": { "reason": { "const": "changed-mind" }, "personalized": { "const": true } } }
    },
    {
      "$comment": "Fail-closed.",
      "if": { "required": ["need_review"], "properties": { "need_review": { "const": false } } },
      "then": { "required": ["confidence_score"], "properties": { "confidence_score": { "minimum": 0.7 } } }
    }
  ]
}
