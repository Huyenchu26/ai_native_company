{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://us-warm-opc/schema/order-status.schema.json",
  "title": "Order Status (FUL-001/002 output)",
  "description": "Order fulfillment with 2 ethical hard gates: QC-before-ship and no-fake-tracking. evidence[] unified contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["order_id", "sku", "routed", "qc_photo_pass", "material_gsm", "ship_approved", "tracking_sent", "carrier_code", "carrier_verified", "evidence", "confidence_score", "need_review"],
  "properties": {
    "order_id": { "type": "string", "minLength": 1 },
    "sku": { "type": "string", "minLength": 1 },
    "order_value": { "type": ["number", "null"] },
    "routed": { "type": "boolean" },
    "supplier_qc_capable": { "type": "boolean" },
    "qc_photo_pass": { "type": "boolean" },
    "material_gsm": { "type": "integer", "minimum": 0 },
    "personalization_correct": { "type": "boolean" },
    "ship_approved": { "type": "boolean" },
    "tracking_sent": { "type": "boolean" },
    "carrier_code": { "type": ["string", "null"], "description": "Real carrier tracking number, or null. NEVER a fake/placeholder code." },
    "carrier_verified": { "type": "boolean" },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["claim", "verbatim_quote", "source"],
        "properties": { "claim": {"type": "string"}, "verbatim_quote": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "location": {"type": "string"} } }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "need_review": { "type": "boolean" }
  },
  "allOf": [
    {
      "$comment": "GATE 1 QC-before-ship: ship_approved=true => qc_photo_pass AND material_gsm>=260 AND personalization_correct.",
      "if": { "required": ["ship_approved"], "properties": { "ship_approved": { "const": true } } },
      "then": { "required": ["qc_photo_pass", "material_gsm", "personalization_correct"],
        "properties": { "qc_photo_pass": {"const": true}, "material_gsm": {"minimum": 260}, "personalization_correct": {"const": true} } }
    },
    {
      "$comment": "GATE 2 no-fake-tracking: tracking_sent=true => carrier_code present AND carrier_verified=true.",
      "if": { "required": ["tracking_sent"], "properties": { "tracking_sent": { "const": true } } },
      "then": { "required": ["carrier_code", "carrier_verified"],
        "properties": { "carrier_code": {"type": "string", "minLength": 1}, "carrier_verified": {"const": true} } }
    },
    {
      "$comment": "Fail-closed: need_review=false => confidence>=0.7.",
      "if": { "required": ["need_review"], "properties": { "need_review": { "const": false } } },
      "then": { "required": ["confidence_score"], "properties": { "confidence_score": { "minimum": 0.7 } } }
    }
  ]
}
