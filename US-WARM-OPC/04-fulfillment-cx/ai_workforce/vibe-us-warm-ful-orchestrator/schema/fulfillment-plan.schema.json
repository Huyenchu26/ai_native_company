{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://us-warm-opc/schema/fulfillment-plan.schema.json",
  "title": "Fulfillment Plan (orchestrator output)",
  "description": "Routes order->QC->ship->CX for DAKOfits US. Gate: shipped orders require QC pass + real tracking. evidence[] unified contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["batch_id", "orders", "shipped", "evidence", "confidence_score", "need_review"],
  "properties": {
    "batch_id": { "type": "string", "minLength": 1 },
    "orders": { "type": "array", "items": { "type": "object" } },
    "shipped": {
      "type": "array",
      "description": "Shipped orders: each must have QC pass + real verified tracking.",
      "items": { "type": "object", "required": ["order_id", "qc_photo_pass", "carrier_verified"],
        "properties": { "order_id": {"type": "string"}, "qc_photo_pass": {"const": true}, "carrier_verified": {"const": true} } }
    },
    "open_tickets": { "type": "array", "items": { "type": "object" } },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["claim", "verbatim_quote", "source"],
        "properties": { "claim": {"type": "string"}, "verbatim_quote": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "location": {"type": "string"} } }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "need_review": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "required": ["need_review"], "properties": { "need_review": { "const": false } } },
      "then": { "required": ["confidence_score"], "properties": { "confidence_score": { "minimum": 0.7 } } } }
  ]
}
