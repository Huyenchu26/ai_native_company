{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://us-warm-opc/schema/creative-package.schema.json",
  "title": "Gift Creative Package (GRW-005 output)",
  "description": "US gift-emotional ad creative for personalized blankets. Fail-closed: no render tool -> asset_status=script-only (never claims a rendered asset). FTC gate via policy_self_check + validator --prose. evidence[] unified contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["creative_id", "sku", "angle", "hooks", "script", "policy_self_check", "asset_status", "launch_ready", "evidence", "confidence_score", "need_review"],
  "properties": {
    "creative_id": { "type": "string", "minLength": 1 },
    "sku": { "type": "string", "minLength": 1 },
    "angle": { "type": "string", "enum": ["gift-occasion", "relationship", "pet-memorial", "seasonal"] },
    "hooks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "script": { "type": "string", "minLength": 1 },
    "policy_self_check": { "type": "boolean", "description": "FTC-clean + no unverified TM + no fake review (validator --prose)." },
    "asset_status": { "type": "string", "enum": ["rendered", "not-generated", "script-only"] },
    "asset_file": { "type": ["string", "null"] },
    "launch_ready": { "type": "boolean" },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["claim", "verbatim_quote", "source"],
        "properties": { "claim": {"type": "string"}, "verbatim_quote": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "location": {"type": "string"} } }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "need_review": { "type": "boolean" }
  },
  "allOf": [
    {
      "$comment": "GATE: launch_ready=true => policy_self_check=true AND asset_status=rendered with asset_file.",
      "if": { "required": ["launch_ready"], "properties": { "launch_ready": { "const": true } } },
      "then": { "required": ["policy_self_check", "asset_status", "asset_file"],
        "properties": { "policy_self_check": {"const": true}, "asset_status": {"const": "rendered"}, "asset_file": {"type": "string", "minLength": 1} } }
    },
    {
      "$comment": "Fail-closed: need_review=false => confidence>=0.7.",
      "if": { "required": ["need_review"], "properties": { "need_review": { "const": false } } },
      "then": { "required": ["confidence_score"], "properties": { "confidence_score": { "minimum": 0.7 } } }
    }
  ]
}
