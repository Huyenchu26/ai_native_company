{
  "name": "vibe-eu-opc-ful-cx",
  "version": "1.0",
  "description": "CX support EN + returns/refund/exchange cho khách US/EU của DAKOfits theo SOP-FUL-003/004: classify ticket (WISMO/size/defect/refund/GDPR), respond EN SLO 2h/SLA 4h, CSAT >=4.0, size XS-3XL, reprint-first, refund auto <=$30 else escalate OPC, EU Art.16(c), GDPR DSAR <=20d.",
  "phases": {
    "classify-ticket": {
      "inputs": ["customer_ticket", "order_context"],
      "outputs": ["ticket_type", "priority"],
      "schema": "schema/ticket-resolution.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "respond": {
      "inputs": ["ticket_type", "size_chart_xs_3xl", "tracking"],
      "outputs": ["reply_en", "first_response_h"],
      "schema": "schema/ticket-resolution.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "exchange": {
      "inputs": ["size_request", "order_context"],
      "outputs": ["replacement_order", "resolution"],
      "schema": "schema/ticket-resolution.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "refund": {
      "inputs": ["refund_request", "defect_evidence", "refund_amount"],
      "outputs": ["refund_executed_or_escalated", "refund_auto_approved", "need_review"],
      "schema": "schema/ticket-resolution.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    }
  },
  "dependencies": {
    "upstream": ["vibe-eu-opc-ful-order-ops"],
    "downstream": ["vibe-eu-opc-bck-finance", "vibe-eu-opc-ful-orchestrator"]
  },
  "scripts": {
    "validator": "script/validator.py",
    "anonymizer": "script/anonymizer.py",
    "install_hooks": "script/install_hooks.sh",
    "log_helper": "script/log_helper.py",
    "review_queue": "script/review_queue.py"
  },
  "folders": {
    "kb": true,
    "script": true,
    "prompt": true,
    "schema": true,
    "test": true,
    "synthetic_data": true
  },
  "quality_gates": [
    {
      "step": "classify-ticket",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "refund",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    }
  ]
}
