{
  "$schema": "./schema/skill-meta.schema.json",
  "name": "vibe-eu-opc-grw-marketing",
  "version": "1.0",
  "description": "Marketing AI cho DAKOfits: tạo & gửi email Klaviyo (cart-abandon/upsell/win-back/seasonal) + lên lịch organic social/community (IG/TikTok/FB + UGC seeding) theo SOP-GRW-003/001. Gate opt-in/GDPR/CAN-SPAM.",
  "phases": {
    "email-flow": {
      "inputs": ["opt-in segment", "cart/order event", "seasonal calendar", "promo offer"],
      "outputs": ["email campaign đã gửi", "revenue-per-email", "execution-log-entry"],
      "schema": "schema/email-campaign.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "organic-post": {
      "inputs": ["content calendar", "creative/UGC", "niche list", "seasonal calendar"],
      "outputs": ["posts đã lên lịch", "organic signal"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "community-seed": {
      "inputs": ["UGC + review consent", "community/group list", "community rules"],
      "outputs": ["UGC seeded", "community engagement log"],
      "min_confidence": 0.7,
      "evidence_required": true
    }
  },
  "dependencies": {
    "upstream": ["vibe-opc-pod-product-niche-research"],
    "downstream": ["vibe-eu-opc-grw-orchestrator"]
  },
  "scripts": {
    "validator": "script/validator.py",
    "anonymizer": "script/anonymizer.py",
    "install_hooks": "script/install_hooks.sh",
    "log_helper": "script/log_helper.py",
    "review_queue": "script/review_queue.py"
  },
  "folders": {
    "kb": true,
    "script": true,
    "prompt": true,
    "schema": true,
    "test": true,
    "synthetic_data": true
  },
  "quality_gates": [
    {
      "step": "email-optin-consent-check",
      "min_confidence": 1.0,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "email-flow-build",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "organic-community-rule-check",
      "min_confidence": 0.7,
      "schema_required": false,
      "evidence_required": true
    }
  ]
}
