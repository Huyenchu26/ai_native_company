{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-aiworkforce/schema/clearance-log.schema.json",
  "title": "Clearance Log (GPSR + IP/TM)",
  "description": "Clearance log ID do Compliance AI cấp (SOP-BCK-004) mà Merch verify trước khi publish EU. Gate cứng: market=EU → gpsr_status PASS bắt buộc để label_ready=true.",
  "type": "object",
  "required": [
    "clearance_id",
    "sku",
    "market",
    "gpsr_status",
    "responsible_person",
    "ip_tm_status",
    "label_ready",
    "evidence",
    "confidence_score",
    "need_review"
  ],
  "properties": {
    "clearance_id": {
      "type": "string",
      "description": "ID duy nhất của clearance log, vd CLR-2026-0623-001"
    },
    "sku": {
      "type": "string",
      "description": "SKU/SP được clear"
    },
    "market": {
      "type": "string",
      "enum": ["US", "EU"],
      "description": "Thị trường publish"
    },
    "gpsr_status": {
      "type": "string",
      "enum": ["PASS", "FAIL"],
      "description": "Kết quả GPSR clearance (EU 2023/988)"
    },
    "responsible_person": {
      "type": "object",
      "description": "Responsible Person đặt tại EU",
      "required": ["name", "address", "email"],
      "properties": {
        "name": {"type": "string"},
        "address": {"type": "string"},
        "email": {"type": "string", "format": "email"}
      }
    },
    "ip_tm_status": {
      "type": "string",
      "enum": ["PASS", "MODIFY", "REJECT"],
      "description": "Kết quả IP/TM check theo tên breed/niche (USPTO TESS + EUIPO). Conservative default REJECT khi nghi ngờ."
    },
    "label_ready": {
      "type": "boolean",
      "description": "Nhãn an toàn EU đủ trường, sẵn chèn product page"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "Link/ghi chú bằng chứng: RP registry, TM search result, label QC"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Độ tin cậy quyết định; <0.7 → need_review=true"
    },
    "need_review": {
      "type": "boolean",
      "description": "Cần human review (confidence thấp hoặc nghi trademark)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"market": {"const": "EU"}},
        "required": ["market"]
      },
      "then": {
        "if": {
          "properties": {"label_ready": {"const": true}},
          "required": ["label_ready"]
        },
        "then": {
          "properties": {"gpsr_status": {"const": "PASS"}},
          "required": ["gpsr_status"]
        }
      }
    }
  ]
}
