{
  "$schema": "./schema/skill-meta.schema.json",
  "name": "vibe-eu-opc-prd-design",
  "version": "1.0",
  "description": "Tạo AOP design print-ready 300 DPI (4 loại tile/watercolor/funny/mandala) + QC 360° seamless và IP/TM clearance USPTO+EUIPO theo SOP-PRD-003/004 cho DAKOfits; gate cứng no-clearance-no-listing, handoff Merch.",
  "phases": {
    "generate-design": {
      "inputs": ["validated_niche", "brand_style_guide", "provider_template_spec"],
      "outputs": ["aop_design_file_300dpi", "seamless_tile"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "qc-360": {
      "inputs": ["aop_design_file_300dpi"],
      "outputs": ["qc_report_360", "mockup_set"],
      "schema": "schema/design-clearance.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "ip-clearance": {
      "inputs": ["niche_term", "design_file", "ip_pre_flag"],
      "outputs": ["ip_clearance_log"],
      "schema": "schema/design-clearance.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "handoff": {
      "inputs": ["print_ready_design", "ip_clearance_log"],
      "outputs": ["merch_handoff_package"],
      "min_confidence": 0.7,
      "evidence_required": true
    }
  },
  "dependencies": {
    "upstream": ["vibe-eu-opc-prd-niche-research"],
    "downstream": ["vibe-eu-opc-mer-orchestrator", "vibe-eu-opc-prd-orchestrator"]
  },
  "scripts": {
    "validator": "script/validator.py",
    "anonymizer": "script/anonymizer.py",
    "install_hooks": "script/install_hooks.sh",
    "log_helper": "script/log_helper.py",
    "review_queue": "script/review_queue.py"
  },
  "hooks": {
    "config": "hooks.json"
  },
  "folders": {
    "kb": true,
    "script": true,
    "prompt": true,
    "schema": true,
    "test": true,
    "synthetic_data": true
  },
  "quality_gates": [
    {
      "step": "qc-360",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "ip-clearance",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "handoff",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    }
  ]
}
