{
  "$schema": "./schema/skill-meta.schema.json",
  "name": "vibe-eu-opc-prd-niche-research",
  "version": "1.0",
  "description": "Nghiên cứu & chấm điểm niche đa-niche + audience sizing + competitor ad spy + competitor price/offer intel + seasonal calendar + IP/TM pre-flag cho POD AOP leggings/activewear DAKOfits theo SOP-PRD-001/002. Output validated niche list + competitor price table mang evidence/confidence/need_review.",
  "phases": {
    "score-niche": {
      "inputs": ["niche seed list", "AdSpy/BigSpy export", "Google Trends CSV"],
      "outputs": ["scored niche table"],
      "schema": "schema/niche-validation.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "size-audience": {
      "inputs": ["shortlisted niche", "Meta Audience Insights export"],
      "outputs": ["audience size per niche (US+EU)"],
      "schema": "schema/niche-validation.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "spy-competitor": {
      "inputs": ["niche", "AdSpy/BigSpy ad data"],
      "outputs": ["competition_level + active ad evidence"],
      "schema": "schema/niche-validation.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "competitor-price-capture": {
      "inputs": ["validated niche", "competitor list (Gearbunch + tương tự)", "Meta Ad Library", "AdSpy/BigSpy ad data"],
      "outputs": ["competitor price table per niche (price range + offers + ad longevity) -> handoff SOP-MER-003"],
      "schema": "schema/niche-validation.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "seasonal-calendar": {
      "inputs": ["validated niche list", "Google Trends seasonality", "holiday calendar US+EU"],
      "outputs": ["seasonal opportunity calendar", "design deadline (peak - lead-time >=6w)"],
      "schema": "schema/niche-validation.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    }
  },
  "dependencies": {
    "upstream": ["vibe-company-orchestrator", "vibe-eu-opc-prd-orchestrator"],
    "downstream": ["vibe-eu-opc-prd-design", "vibe-eu-opc-prd-orchestrator"]
  },
  "scripts": {
    "validator": "script/validator.py",
    "anonymizer": "script/anonymizer.py",
    "install_hooks": "script/install_hooks.sh",
    "log_helper": "script/log_helper.py",
    "review_queue": "script/review_queue.py"
  },
  "folders": {
    "kb": true,
    "script": true,
    "prompt": true,
    "schema": true,
    "test": true,
    "synthetic_data": true
  },
  "quality_gates": [
    {
      "step": "score-niche",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "size-audience",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "seasonal-calendar",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    }
  ],
  "hooks": {
    "config": "hooks.json"
  }
}
