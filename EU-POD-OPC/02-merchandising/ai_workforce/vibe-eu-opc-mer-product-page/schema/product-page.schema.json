{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-aiworkforce/schema/product-page.schema.json",
  "title": "Product Page (PDP) Output — vibe-eu-opc-mer-product-page",
  "description": "Schema cho 1 product page publish-ready theo SOP-MER-001. Gate: no-GPSR-no-publish (EU) fail-closed.",
  "type": "object",
  "required": [
    "sku",
    "headline",
    "body_copy",
    "upsell_bundle",
    "social_proof",
    "gpsr_clearance_id",
    "gpsr_label_present",
    "market",
    "evidence",
    "confidence_score",
    "need_review"
  ],
  "properties": {
    "sku": {
      "type": "string",
      "description": "SKU sản phẩm chính (AOP leggings)"
    },
    "headline": {
      "type": "string",
      "description": "Title benefit + niche, mobile above-fold"
    },
    "body_copy": {
      "type": "object",
      "description": "Thân copy: bullets + description + size guide + care",
      "required": ["bullets", "description", "size_guide"],
      "properties": {
        "bullets": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 5,
          "description": "5 bullet scannable above-fold value"
        },
        "description": {"type": "string", "description": "Story + 360° AOP show-off"},
        "size_guide": {
          "type": "string",
          "description": "Size guide XS–3XL (cm/inch)"
        },
        "care_info": {"type": "string"},
        "cro_elements_passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "Số CRO element pass (target ≥12*0.95)"
        }
      }
    },
    "upsell_bundle": {
      "type": "object",
      "description": "Upsell/bundle leggings + sports-bra cùng AOP (bắt buộc)",
      "required": ["present", "bundle_sku", "copy"],
      "properties": {
        "present": {"type": "boolean", "const": true},
        "bundle_sku": {"type": "string", "description": "Sports-bra SKU cùng niche hoặc activewear generic"},
        "copy": {"type": "string"}
      }
    },
    "social_proof": {
      "type": "object",
      "required": ["rating", "review_snippets"],
      "properties": {
        "rating": {"type": "number", "minimum": 0, "maximum": 5},
        "review_snippets": {"type": "array", "items": {"type": "string"}},
        "ugc_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gpsr_clearance_id": {
      "type": ["string", "null"],
      "description": "Clearance log ID từ SOP-BCK-004. null khi không xác nhận được → BLOCK (EU)."
    },
    "gpsr_clearance_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "NOT_FOUND", "MISSING", "N/A"],
      "description": "Kết quả VERIFY log ID (không chỉ check string). N/A cho SP chỉ US."
    },
    "gpsr_label_present": {
      "type": "boolean",
      "description": "Block GPSR đã chèn trên PDP (đơn EU). False với SP chỉ US là hợp lệ."
    },
    "gpsr_label_block": {
      "type": ["string", "null"],
      "description": "Nội dung label: Responsible Person (EU) + cảnh báo + care/material + mã SP"
    },
    "market": {
      "type": "string",
      "enum": ["US", "EU"],
      "description": "Thị trường bán. EU bắt buộc GPSR gate + label."
    },
    "publish_status": {
      "type": "string",
      "enum": ["publish-ready", "blocked", "needs-review"],
      "description": "blocked khi GPSR fail-closed"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "clearance log ID, design ID, SKU nguồn, review source…"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "min 0.7 để publish"
    },
    "need_review": {
      "type": "boolean",
      "description": "true khi gate block / CRO<95% / thiếu data"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"market": {"const": "EU"}}
      },
      "then": {
        "properties": {
          "gpsr_clearance_status": {"const": "PASS"},
          "gpsr_label_present": {"const": true}
        },
        "required": ["gpsr_clearance_status", "gpsr_label_block"]
      }
    }
  ]
}
