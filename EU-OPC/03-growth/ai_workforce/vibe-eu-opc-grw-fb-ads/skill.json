{
  "name": "vibe-eu-opc-grw-fb-ads",
  "version": "1.0",
  "description": "Chạy & tối ưu FB Ads cho POD AOP leggings DAKOfits (US+EU) theo SOP-GRW-002 & SOP-GRW-004: build ABO→CBO, 4-layer targeting, verify CAPI EMQ≥6, scale/kill theo Blended ROAS ≥ BE-ROAS per-SKU, BM 5-tier anti-ban. Gate cứng: no Meta Ad Policy → no ads.",
  "phases": {
    "build-campaign": {
      "inputs": ["live-product", "creative-package", "ad-budget", "niche-hint", "meta-policy-clearance"],
      "outputs": ["abo-test-plan", "bm-tier-mapping"],
      "schema": "schema/campaign-decision.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "read-signal": {
      "inputs": ["ads-manager-metrics", "capi-emq", "shopbase-orders"],
      "outputs": ["platform-roas", "blended-roas", "cpa", "anomaly-flags"],
      "schema": "schema/campaign-decision.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "scale-kill": {
      "inputs": ["platform-roas", "blended-roas", "break-even-roas", "cpa", "budget-cap-status"],
      "outputs": ["campaign-decision"],
      "schema": "schema/campaign-decision.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "report": {
      "inputs": ["cross-channel-metrics", "finance-reconciled-cost"],
      "outputs": ["growth-report-daily", "growth-report-weekly", "alerts"],
      "schema": "schema/campaign-decision.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    }
  },
  "dependencies": {
    "upstream": ["vibe-eu-opc-grw-creative", "vibe-eu-opc-merch-*"],
    "downstream": ["vibe-eu-opc-grw-orchestrator"]
  },
  "scripts": {
    "validator": "script/validator.py",
    "anonymizer": "script/anonymizer.py",
    "install_hooks": "script/install_hooks.sh",
    "log_helper": "script/log_helper.py",
    "review_queue": "script/review_queue.py"
  },
  "hooks": {
    "config": "hooks.json"
  },
  "folders": {
    "kb": true,
    "script": true,
    "prompt": true,
    "schema": true,
    "test": true,
    "synthetic_data": true
  },
  "quality_gates": [
    {
      "step": "meta-ad-policy-gate",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "capi-emq-gate",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "scale-commit-gate",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "budget-cap-gate",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "report-reconcile-gate",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    }
  ]
}
