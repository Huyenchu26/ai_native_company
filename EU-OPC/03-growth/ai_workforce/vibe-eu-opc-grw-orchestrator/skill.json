{
  "$schema": "../schema/skill-meta.schema.json",
  "name": "vibe-eu-opc-grw-orchestrator",
  "version": "1.0",
  "description": "Manager điều phối toàn bộ phòng Growth DAKOfits: route task ads/creative/email/organic sang đúng specialist, vận hành promote theo đợt (5-10 SP), enforce gate cứng, đọc growth report. KHÔNG execute trực tiếp.",
  "phases": {
    "receive": {
      "inputs": ["growth task", "batch 5-10 SP từ 02-merch (SOP-MER-006)", "context: README/_workflow/_rules/unit-economics"],
      "outputs": ["task được hiểu (đơn lẻ vs batch)"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "classify": {
      "inputs": ["task đã nhận"],
      "outputs": ["mapping task → worker → SOP (hoặc escalate phòng khác)"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "route": {
      "inputs": ["classified task", "live product", "budget cap", "policy clearance status", "break-even ROAS per-SKU"],
      "outputs": ["delegation tới fb-ads / creative / marketing", "growth-batch-plan"],
      "schema": "schema/growth-batch-plan.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "enforce-gate": {
      "inputs": ["routing decision", "creative+page clearance", "opt-in status", "blended ROAS vs BE-ROAS", "daily spend"],
      "outputs": ["PASS → cho launch / HOLD → need_review + escalate"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "report": {
      "inputs": ["growth report (GRW-004) từ fb-ads", "ROAS/CPA per-SKU"],
      "outputs": ["quyết định điều phối: scale winner / kill loser / refresh / escalate", "report tổng hợp đợt"],
      "min_confidence": 0.7,
      "evidence_required": true
    }
  },
  "dependencies": {
    "upstream": ["vibe-opc-pod-merch-catalog-sync"],
    "downstream": ["vibe-eu-opc-grw-fb-ads", "vibe-eu-opc-grw-creative", "vibe-eu-opc-grw-marketing"]
  },
  "scripts": {
    "validator": "script/validator.py",
    "anonymizer": "script/anonymizer.py",
    "install_hooks": "script/install_hooks.sh",
    "log_helper": "script/log_helper.py",
    "review_queue": "script/review_queue.py"
  },
  "folders": {
    "kb": true,
    "script": true,
    "prompt": true,
    "schema": true,
    "test": true,
    "synthetic_data": true
  },
  "hooks": {
    "config": "hooks.json"
  },
  "quality_gates": [
    {
      "step": "enforce-gate:meta-policy",
      "min_confidence": 0.7,
      "schema_required": false,
      "evidence_required": true
    },
    {
      "step": "enforce-gate:email-optin",
      "min_confidence": 0.7,
      "schema_required": false,
      "evidence_required": true
    },
    {
      "step": "enforce-gate:winner-break-even-roas",
      "min_confidence": 0.7,
      "schema_required": false,
      "evidence_required": true
    },
    {
      "step": "enforce-gate:budget-escalate-150",
      "min_confidence": 0.7,
      "schema_required": false,
      "evidence_required": true
    },
    {
      "step": "route:growth-batch-plan",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    }
  ]
}
