{
  "$schema": "./schema/skill-meta.schema.json",
  "name": "vibe-eu-opc-mer-product-page",
  "version": "1.0",
  "description": "Viết ShopBase product page copy (EN) cho POD AOP leggings/activewear đa-niche DAKOfits theo SOP-MER-001: headline, bullets, story, size guide XS–3XL, upsell sports-bra, social proof + chèn nhãn GPSR (đơn EU), tối ưu mobile CRO. Gate cứng no-GPSR-no-publish fail-closed.",
  "phases": {
    "draft-copy": {
      "inputs": ["cleared design", "blueprint/variant", "brand voice"],
      "outputs": ["headline", "bullets", "description", "size-guide"],
      "schema": "schema/product-page.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "upsell": {
      "inputs": ["sports-bra SKU", "niche"],
      "outputs": ["upsell_bundle"],
      "schema": "schema/product-page.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "gpsr-label": {
      "inputs": ["gpsr clearance log ID", "responsible person", "market"],
      "outputs": ["gpsr_label_present", "gpsr_label_block"],
      "schema": "schema/product-page.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "cro-check": {
      "inputs": ["draft PDP", "CRO checklist 12 elements"],
      "outputs": ["publish-ready PDP", "need_review"],
      "schema": "schema/product-page.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    }
  },
  "dependencies": {
    "upstream": ["vibe-eu-opc-mer-catalog", "vibe-opc-pod-backoffice-compliance"],
    "downstream": ["vibe-eu-opc-grw-fb-ads", "vibe-eu-opc-mer-orchestrator"]
  },
  "scripts": {
    "validator": "script/validator.py",
    "anonymizer": "script/anonymizer.py",
    "install_hooks": "script/install_hooks.sh",
    "log_helper": "script/log_helper.py",
    "review_queue": "script/review_queue.py"
  },
  "folders": {
    "kb": true,
    "script": true,
    "prompt": true,
    "schema": true,
    "test": true,
    "synthetic_data": true
  },
  "quality_gates": [
    {
      "step": "gpsr-gate-verify-clearance-log",
      "min_confidence": 1.0,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "gpsr-label-present-eu",
      "min_confidence": 1.0,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "mobile-cro-completeness",
      "min_confidence": 0.95,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "upsell-block-present",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    }
  ]
}
