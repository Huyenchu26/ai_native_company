{
  "$schema": "./schema/skill-meta.schema.json",
  "name": "vibe-eu-opc-mer-orchestrator",
  "version": "1.0",
  "description": "Manager điều phối phòng Merchandising DAKOfits (POD AOP leggings đa-niche ~3.200 SP, US+EU): route setup/pricing/page/sync sang specialist, vận hành promote theo đợt (SOP-MER-006), enforce gate cứng (GPSR, contribution margin) và handoff batch package cho Growth.",
  "phases": {
    "receive": {
      "inputs": ["cleared-design", "gpsr-clearance", "batch-input", "growth-roas-feedback"],
      "outputs": ["classified-request"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "classify": {
      "inputs": ["classified-request"],
      "outputs": ["routing-decision"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "route": {
      "inputs": ["routing-decision"],
      "outputs": ["delegated-task"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "enforce-gate": {
      "inputs": ["delegated-task-result", "pricing", "gpsr-clearance"],
      "outputs": ["gate-checked-batch"],
      "schema": "schema/merch-batch-plan.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "handoff-growth": {
      "inputs": ["gate-checked-batch"],
      "outputs": ["merch-batch-plan", "scale-cut-decision"],
      "schema": "schema/merch-batch-plan.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    }
  },
  "dependencies": {
    "upstream": ["vibe-opc-pod-product-design"],
    "downstream": [
      "vibe-eu-opc-mer-catalog",
      "vibe-eu-opc-mer-product-page",
      "vibe-eu-opc-grw-orchestrator"
    ]
  },
  "scripts": {
    "validator": "script/validator.py",
    "anonymizer": "script/anonymizer.py",
    "install_hooks": "script/install_hooks.sh",
    "log_helper": "script/log_helper.py",
    "review_queue": "script/review_queue.py"
  },
  "folders": {
    "kb": true,
    "script": true,
    "prompt": true,
    "schema": true,
    "test": true,
    "synthetic_data": true
  },
  "quality_gates": [
    {
      "step": "enforce-gate:gpsr",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "enforce-gate:contribution-margin",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "enforce-gate:pricing-floor",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "handoff-growth",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    }
  ],
  "hooks": {
    "config": "hooks.json"
  }
}
