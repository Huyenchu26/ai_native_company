{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-aiworkforce/schema/merch-batch-plan.schema.json",
  "title": "Merch Batch Plan (SOP-MER-006 promote theo đợt)",
  "description": "Output của orchestrator: kế hoạch promote theo đợt 5–10 SP, đã enforce gate, sẵn handoff Growth.",
  "type": "object",
  "required": [
    "batch_id",
    "products",
    "gate_checks",
    "routing",
    "handoff_to_growth",
    "evidence",
    "confidence_score",
    "need_review"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "description": "ID đợt promote, vd MER006-2026-W26-01"
    },
    "products": {
      "type": "array",
      "description": "5–10 SP trong đợt",
      "minItems": 5,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["sku", "title", "market"],
        "properties": {
          "sku": {"type": "string"},
          "title": {"type": "string"},
          "niche": {"type": "string"},
          "market": {"type": "string", "enum": ["US", "EU", "US+EU"]},
          "shopbase_url": {"type": "string"},
          "price": {"type": "number"},
          "be_roas": {"type": "number", "description": "Break-even ROAS riêng theo SKU/market (1/GM)"}
        }
      }
    },
    "gate_checks": {
      "type": "object",
      "description": "Gate cứng phải pass trước handoff",
      "required": ["gpsr", "contribution_margin", "pricing_floor"],
      "properties": {
        "gpsr": {
          "type": "object",
          "required": ["passed"],
          "properties": {
            "passed": {"type": "boolean"},
            "applies_to_eu": {"type": "boolean"},
            "clearance_ref": {"type": "string"},
            "note": {"type": "string"}
          }
        },
        "contribution_margin": {
          "type": "object",
          "required": ["passed"],
          "properties": {
            "passed": {"type": "boolean"},
            "min_contribution_margin": {"type": "number", "description": "CM sau ads (giá−base−ship−fee−CPA−VAT−fx)/giá"},
            "note": {"type": "string"}
          }
        },
        "pricing_floor": {
          "type": "object",
          "required": ["passed"],
          "properties": {
            "passed": {"type": "boolean"},
            "gross_margin": {"type": "number"},
            "band": {"type": "string", "default": "45-55%"},
            "note": {"type": "string"}
          }
        }
      }
    },
    "routing": {
      "type": "array",
      "description": "Quyết định route task → worker → SOP",
      "items": {
        "type": "object",
        "required": ["task", "worker", "sop"],
        "properties": {
          "task": {"type": "string"},
          "worker": {
            "type": "string",
            "enum": [
              "vibe-eu-opc-mer-catalog",
              "vibe-eu-opc-mer-product-page",
              "vibe-eu-opc-grw-orchestrator",
              "self"
            ]
          },
          "sop": {"type": "string"},
          "status": {"type": "string", "enum": ["pending", "in_progress", "done", "blocked"]}
        }
      }
    },
    "handoff_to_growth": {
      "type": "boolean",
      "description": "true chỉ khi mọi gate_checks.passed = true và confidence_score >= 0.7"
    },
    "scale_cut_decision": {
      "type": "array",
      "description": "Sau khi đọc ROAS/CPA per-SKU từ Growth",
      "items": {
        "type": "object",
        "properties": {
          "sku": {"type": "string"},
          "blended_roas": {"type": "number"},
          "cpa": {"type": "number"},
          "decision": {"type": "string", "enum": ["scale", "optimize", "cut", "archive"]},
          "rationale": {"type": "string"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Bằng chứng cho mỗi gate/decision (link log, screenshot, calc)",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "need_review": {
      "type": "boolean",
      "description": "true nếu confidence < 0.7 hoặc bất kỳ gate fail"
    }
  }
}
