{
  "$schema": "./schema/skill-meta.schema.json",
  "name": "vibe-eu-opc-ful-order-ops",
  "version": "1.0",
  "description": "Order-Ops AI cho DAKOfits: giám sát đơn ShopBase + verify payment/address/SKU variant XS-3XL + route Printify theo vung US->US/EU->EU (SLO 18h, ceiling 24h) + gui tracking EN (SLO 6h) theo SOP-FUL-001/002.",
  "phases": {
    "monitor": {
      "inputs": ["ShopBase paid orders", "payment status", "shipping address US/EU", "line items SKU+variant"],
      "outputs": ["order list moi (2h cadence)"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "verify": {
      "inputs": ["order list", "Printify SKU mapping", "fraud/risk flag"],
      "outputs": ["verify_status PASS/HOLD/FRAUD", "exception log"],
      "schema": "schema/order-routing.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "route": {
      "inputs": ["verified order", "ship country", "provider-by-region map"],
      "outputs": ["order submitted Printify", "routed_at timestamp"],
      "schema": "schema/order-routing.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "send-tracking": {
      "inputs": ["fulfilled order", "tracking number + carrier"],
      "outputs": ["tracking email EN gui khach", "ShopBase fulfillment updated", "cost data -> 05-backoffice"],
      "schema": "schema/order-routing.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    }
  },
  "dependencies": {
    "upstream": ["vibe-eu-opc-grw-orchestrator"],
    "downstream": ["vibe-eu-opc-ful-cx", "vibe-eu-opc-bck-finance", "vibe-eu-opc-ful-orchestrator"]
  },
  "scripts": {
    "validator": "script/validator.py",
    "anonymizer": "script/anonymizer.py",
    "install_hooks": "script/install_hooks.sh",
    "log_helper": "script/log_helper.py",
    "review_queue": "script/review_queue.py"
  },
  "folders": {
    "kb": true,
    "script": true,
    "prompt": true,
    "schema": true,
    "test": true,
    "synthetic_data": true
  },
  "quality_gates": [
    { "step": "verify", "min_confidence": 0.7, "schema_required": true, "evidence_required": true },
    { "step": "route", "min_confidence": 0.7, "schema_required": true, "evidence_required": true },
    { "step": "send-tracking", "min_confidence": 0.7, "schema_required": true, "evidence_required": true }
  ]
}
