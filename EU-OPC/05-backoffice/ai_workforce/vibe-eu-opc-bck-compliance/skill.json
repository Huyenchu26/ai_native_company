{
  "$schema": "./schema/skill-meta.schema.json",
  "name": "vibe-eu-opc-bck-compliance",
  "version": "1.0",
  "description": "Compliance GATE issuer của DAKOfits: cấp GPSR clearance (Responsible Person EU + nhãn) + IP/TM check (USPTO/EUIPO) + GDPR (RoPA/DSAR/breach 72h) + Meta Ad Policy pre-check theo SOP-BCK-004/005. Output clearance log ID PASS/FAIL mà Merch verify trước publish EU; gate no-GPSR-no-publish, budget 0%.",
  "phases": {
    "gpsr-clearance": {
      "inputs": ["design+niche cleared (vibe-eu-opc-prd-design)", "provider EU info", "product safety data"],
      "outputs": ["clearance log ID (PASS/FAIL)", "nhãn an toàn EU"],
      "schema": "schema/clearance-log.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "ip-tm-check": {
      "inputs": ["breed/niche name", "market (US/EU)"],
      "outputs": ["ip_tm_status (PASS/MODIFY/REJECT)", "TM search record"],
      "schema": "schema/clearance-log.schema.json",
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "gdpr-dsar": {
      "inputs": ["DSAR/erasure request (CX)", "consent records", "RoPA"],
      "outputs": ["DSAR resolution log (≤1 tháng)", "RoPA update"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "breach-notify": {
      "inputs": ["incident alert", "risk assessment"],
      "outputs": ["breach log (immutable)", "notification draft ≤72h"],
      "min_confidence": 0.7,
      "evidence_required": true
    },
    "meta-policy-precheck": {
      "inputs": ["ad creative", "landing page"],
      "outputs": ["Meta Ad Policy flag (PASS/MODIFY/REJECT)"],
      "min_confidence": 0.7,
      "evidence_required": true
    }
  },
  "dependencies": {
    "upstream": ["vibe-eu-opc-prd-design"],
    "downstream": ["vibe-eu-opc-mer-orchestrator", "vibe-eu-opc-grw-orchestrator", "vibe-eu-opc-bck-orchestrator"]
  },
  "scripts": {
    "validator": "script/validator.py",
    "anonymizer": "script/anonymizer.py",
    "install_hooks": "script/install_hooks.sh",
    "log_helper": "script/log_helper.py",
    "review_queue": "script/review_queue.py"
  },
  "folders": {
    "kb": true,
    "script": true,
    "prompt": true,
    "schema": true,
    "test": true,
    "synthetic_data": true
  },
  "hooks": {
    "config": "hooks.json"
  },
  "quality_gates": [
    {
      "step": "gpsr-clearance",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "ip-tm-check",
      "min_confidence": 0.7,
      "schema_required": true,
      "evidence_required": true
    },
    {
      "step": "gdpr-dsar",
      "min_confidence": 0.7,
      "schema_required": false,
      "evidence_required": true
    },
    {
      "step": "breach-notify",
      "min_confidence": 0.7,
      "schema_required": false,
      "evidence_required": true
    },
    {
      "step": "meta-policy-precheck",
      "min_confidence": 0.7,
      "schema_required": false,
      "evidence_required": true
    }
  ]
}
